# Copy to .env.local only if you need to override a default.
# Every value here is already the default, so an absent .env.local is correct
# for a live demo: the console talks to the API on :8000 and shows real data.

# Where the FastAPI server is. The console talks to nothing else.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Set to 1 to run the console against the fixtures in src/mocks instead of the
# API. Useful for frontend work with no Python running. Never set this for a
# demo: the figures on screen would be invented rather than computed, which is
# the one thing this system exists not to do.
NEXT_PUBLIC_USE_MOCKS=0

# Playback speed for the mock SSE stream. Higher is faster. Ignored when
# NEXT_PUBLIC_USE_MOCKS is 0.
NEXT_PUBLIC_MOCK_SPEED=1
