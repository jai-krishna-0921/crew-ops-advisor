# Copy to .env.local and fill in only what you need.
#
# Every value here is already the default (unset), so an absent .env.local is
# a correct and fully working state: the deterministic resolver answers with
# no key at all, through the same tools, the same rules engine and the same
# grounding check that agent mode uses. Nothing below turns that off; it only
# adds a language model that plans the turn and writes the prose.
#
# `.env.local` is read before `.env`, and neither overrides a variable already
# set in the real environment. Both are gitignored; this file is the one
# that is not, so a fresh checkout has something to copy from.
# See docs/SETUP.md for the full walkthrough.

# ---------------------------------------------------------------- providers
# Set exactly one of these to turn on the LangGraph agent. Selection is by
# presence, checked in this order: Anthropic, then OpenAI, then Ollama. A
# stale or placeholder value still counts as "set" and will be picked, which
# is the most common cause of agent mode silently failing to authenticate.
# CREWOPS_LLM_PROVIDER below exists to force a choice when that happens.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_API_KEY=OLLAMA_API_KEY=b268a51d95374cb4b887a01ce346728f.YW634wwWvwe6QDrd4pU-shic
# Alternative to OLLAMA_API_KEY for a local, unauthenticated Ollama install.
OLLAMA_HOST=

# Force one provider instead of the presence-based order above. One of
# anthropic, openai, ollama. Leave blank to auto-select.
CREWOPS_LLM_PROVIDER=

# --------------------------------------------------------------------- model
# All optional. Each falls back to the selected provider's own default.

# Overrides the model id for the selected provider.
CREWOPS_MODEL=
# A separate, usually cheaper, model for the planning step only. Falls back
# to CREWOPS_MODEL when unset.
CREWOPS_PLAN_MODEL=
# Output token ceilings.
CREWOPS_MAX_TOKENS=
CREWOPS_PLAN_MAX_TOKENS=
# How many tool round trips one turn may take before it has to answer anyway.
CREWOPS_MAX_TOOL_ITERATIONS=
# Milliseconds before a turn is cut off and asked to answer with what it has.
# The problem statement is explicit that a 45 second response is not a
# decision aid; this defaults to 30000 and should not be raised past it.
CREWOPS_TURN_BUDGET_MS=
# How many times the grounding guard may send a draft back for a figure it
# could not attest, before the turn is refused instead.
CREWOPS_MAX_REPAIRS=

# -------------------------------------------------------------------- memory
# Where conversation turns are logged as SQLite. Defaults to
# api/.crewops/memory.db, created on first run.
CREWOPS_MEMORY_DB=

# Voice conversation, independent of the reasoning provider.
# See docs/VOICE.md. Hosted voice uses Sarvam by default.
CREWOPS_VOICE_PROVIDER=sarvam
SARVAM_API_KEY=
# Local VoiceKit is intentionally disabled for hosting. These settings are
# retained only for optional local development and are not required.
# CREWOPS_VOICE_LOCAL_URL=http://127.0.0.1:8001
# CREWOPS_VOICE_LOCAL_VOICE=af_heart
# CREWOPS_VOICE_LOCAL_KEY=
# GEMINI_API_KEY=
# CREWOPS_SARVAM_STT_MODEL=saaras:v3-realtime
# CREWOPS_SARVAM_TTS_MODEL=bulbul:v3
# CREWOPS_SARVAM_VOICE=shubh
# CREWOPS_GEMINI_STT_MODEL=gemini-3.5-transcribe-live
# CREWOPS_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# CREWOPS_GEMINI_VOICE=Kore
# VOICE_OFFLINE=true
